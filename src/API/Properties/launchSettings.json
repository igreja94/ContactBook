{
  "profiles": {
    "http": {
      "commandName": "Project",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:5080"
    },
    "https": {
      "commandName": "Project",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:7062;http://localhost:5080"
    },
    "Container (Dockerfile)": {
        "commandName": "Docker",
        "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
        "environmentVariables": {
            "ASPNETCORE_HTTPS_PORTS": "8081",
            "ASPNETCORE_HTTP_PORTS": "8080",
            "ConnectionStrings__DefaultConnection": "Server=host.docker.internal,1433;Database=ContactBookDb;User Id=sa;Password=!!MyPassword1234;TrustServerCertificate=True"
        },
        "publishAllPorts": true,
        "useSSL": true
    }
  },
  "$schema": "https://json.schemastore.org/launchsettings.json"
}